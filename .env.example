# Application
APP_NAME="Agentic AI Shopping Assistant"
APP_ENV="development"
DEBUG=true
ALLOWED_ORIGINS="http://localhost:4200"

# Database (Shared PostgreSQL with pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (Short-term memory)
REDIS_URL="redis://localhost:6379/1"

# LLM Inference
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-v1-..."

# Internal Backend Integration
MAIN_BACKEND_URL="http://localhost:8000/internal/v1"
SERVICE_TOKEN="secret-service-to-service-token"

# Streaming
STREAM_TIMEOUT_SECONDS=30
